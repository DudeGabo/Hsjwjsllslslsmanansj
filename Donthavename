local function limpiarCharacter(char)
    if not char then return end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("BodyColors") or obj:IsA("CharacterMesh") or obj:IsA("Hat") then
            obj:Destroy()
        end
    end
end

local function limpiarTodos()
    for _, hum in ipairs(Workspace:GetDescendants()) do
        if hum:IsA("Humanoid") and hum.Parent then
            limpiarCharacter(hum.Parent)
        end
    end
end

local function limpiezaRapidaAsync()
    task.spawn(function()
        local start = os.clock()
        while os.clock() - start < 2 do
            limpiarTodos()
            task.wait(0.3)
        end
    end)
end

local function ejecutarFpsKiller()
    limpiezaRapidaAsync()
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local backpack = player:WaitForChild("Backpack")
    local qc = backpack:FindFirstChild("Quantum Cloner")
    if qc then
        humanoid:EquipTool(qc)
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool ~= qc then
                tool.Parent = character
            end
        end
        task.wait(0.01)
        qc:Activate()
        task.wait(0.1)
        humanoid:UnequipTools()
    end
end

local autoLaserLoop
local function activarAutoLaser()
    if autoLaserLoop then return end
    local humanoid, lastEquip = nil, 0
    local SHOT_DELAY = 0.25
    local EQUIP_DELAY = 0.5
    local lastShot = 0

    local function setupCharacter(char)
        humanoid = char:WaitForChild("Humanoid")
    end

    if player.Character then setupCharacter(player.Character) end
    player.CharacterAdded:Connect(setupCharacter)

    local function getNearestPlayer()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local nearest, dist = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local thrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if thrp then
                    local d = (thrp.Position - hrp.Position).Magnitude
                    if d < dist then
                        dist = d
                        nearest = plr
                    end
                end
            end
        end
        return nearest
    end

    local function getTool()
        local backpack = player:FindFirstChild("Backpack")
        return backpack and backpack:FindFirstChild("Laser Cape")
    end

    local function isLaserCapeEquipped()
        local char = player.Character
        return char and char:FindFirstChild("Laser Cape") ~= nil
    end

    local function unequipAllTools()
        local char = player.Character
        local backpack = player:WaitForChild("Backpack")
        if not char then return end
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then
                v.Parent = backpack
            end
        end
    end

    local function equipLaserCape()
        if isLaserCapeEquipped() then return true end
        if tick() - lastEquip < EQUIP_DELAY then return false end
        lastEquip = tick()
        local tool = getTool()
        if not tool then
            pcall(function()
                ReplicatedStorage.Packages.Net["RF/CoinsShopService/RequestBuy"]:InvokeServer("Laser Cape")
            end)
            task.wait(0.2)
            tool = getTool()
        end
        if tool and player.Character then
            tool.Parent = player.Character
            return true
        end
        return false
    end

    local function fireLaserCape(part)
        ReplicatedStorage.Packages.Net["RE/UseItem"]:FireServer(Vector3.new(-481, -6, -64), part)
    end

    autoLaserLoop = task.spawn(function()
        while true do
            if not autoLaserOn then
                unequipAllTools()
                autoLaserLoop = nil
                break
            end
            if humanoid and humanoid.Health > 0 then
                if tick() - lastShot >= SHOT_DELAY then
                    local target = getNearestPlayer()
                    if target and target.Character then
                        if equipLaserCape() then
                            local hitPart = target.Character:FindFirstChild("UpperTorso") or target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head")
                            if hitPart then
                                fireLaserCape(hitPart)
                                lastShot = tick()
                            end
                        end
                    end
                end
            end
            task.wait(0.05)
        end
    end)

    task.spawn(function()
        task.wait(0.1)
        unequipAllTools()
        equipLaserCape()
    end)
end

local function activarSpeedSteal()
    if not speedStealOn then return end
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local backpack = player:WaitForChild("Backpack")
    task.spawn(function()
        while speedStealOn do
            local stealTool = backpack:FindFirstChild("AP Tool")
            if stealTool and humanoid then
                stealTool.Parent = character
                pcall(function() stealTool:Activate() end)
                task.wait(0.1)
                stealTool.Parent = backpack
            end
            task.wait(0.5)
        end
    end)
end

