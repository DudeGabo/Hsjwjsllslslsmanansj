local WALK_THRESHOLD = 0.6
local JUMP_THRESHOLD = 0.6
local COOLDOWN = 4

local nerfHumanoid
local baseWalk, baseJump
local lastTrigger = 0

local function setupNerf(char)
    nerfHumanoid = char:WaitForChild("Humanoid")
    baseWalk = nerfHumanoid.WalkSpeed
    baseJump = nerfHumanoid.JumpPower
    lastTrigger = 0
end

if player.Character then
    setupNerf(player.Character)
end

player.CharacterAdded:Connect(setupNerf)

RunService.Heartbeat:Connect(function()
    if not nerfHumanoid or nerfHumanoid.Health <= 0 then return end

    local nerfed =  
        nerfHumanoid.WalkSpeed < baseWalk * WALK_THRESHOLD or  
        nerfHumanoid.JumpPower < baseJump * JUMP_THRESHOLD  

    local now = tick()  
    if nerfed and now - lastTrigger >= COOLDOWN then  
        lastTrigger = now  

        if autoLaserOn then  
            autoLaserOn = false  
            if autoLaserButton then  
                autoLaserButton.Text = "OFF"  
            end  
        end  
    end
end)
