local function getChar()
	local char = Player.Character or Player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	return char, hum
end

local function equipAll()
	local char = getChar()
	for _, tool in ipairs(Player.Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			tool.Parent = char
		end
	end
end

local function unequip()
	local _, hum = getChar()
	hum:UnequipTools()
end

local function equipQuantum()
	local _, hum = getChar()
	local q = Player.Backpack:FindFirstChild("Quantum Cloner")
	if q then
		hum:EquipTool(q)
	end
	return q
end

local function cleanGunsFor4Seconds()
	local start = tick()
	while tick() - start < 4 do
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Tool") then
				for _, d in ipairs(obj:GetDescendants()) do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = 1
					elseif d:IsA("Decal") or d:IsA("Texture") then
						d.Transparency = 1
					end
				end
			end
		end
		task.wait(0.1)
	end
end

local function limpiarCharacter(char)
	if not char then return end
	for _, obj in ipairs(char:GetChildren()) do
		if obj:IsA("Accessory")
		or obj:IsA("Shirt")
		or obj:IsA("Pants")
		or obj:IsA("ShirtGraphic")
		or obj:IsA("BodyColors")
		or obj:IsA("CharacterMesh")
		or obj:IsA("Hat") then
			obj:Destroy()
		end
	end
end

local function limpiarTodos()
	for _, hum in ipairs(Workspace:GetDescendants()) do
		if hum:IsA("Humanoid") and hum.Parent then
			limpiarCharacter(hum.Parent)
		end
	end
end

local function limpiezaRapidaAsync()
	task.spawn(function()
		local start = os.clock()
		while os.clock() - start < 3 do
			limpiarTodos()
			task.wait(0.3)
		end
	end)
end

task.spawn(function()
	limpiarTodos()
	while true do
		task.wait(5)
		limpiarTodos()
	end
end)

local function KILL_FPS()
	limpiezaRapidaAsync()
	task.spawn(cleanGunsFor4Seconds)

	for i = 1,2 do
		equipAll()
		task.wait(0.02)
		unequip()
		task.wait(0.001)
	end

	task.wait(0.01)

	local q = equipQuantum()
	if not q then return end

	task.wait(0.01)
	equipAll()
	q:Activate()
	task.wait(0.2)
	unequip()
end

