local ALLOWED_NAME = "Namirdanna"
local TIME_LIMIT = 5 * 60 * 60
local TIME_FILE = "gabo_time.dat"

if player.Name ~= ALLOWED_NAME then
    player:Kick("No autorizado")
    return
end

local startTime

if isfile(TIME_FILE) then
    startTime = tonumber(readfile(TIME_FILE))
else
    startTime = os.time()
    writefile(TIME_FILE, tostring(startTime))
end

if os.time() - startTime >= TIME_LIMIT then
    player:Kick("Tiempo de uso agotado (5 horas)")
    return
end

task.spawn(function()
    while true do
        task.wait(5)
        if os.time() - startTime >= TIME_LIMIT then
            player:Kick("Tiempo de uso agotado (5 horas)")
            break
        end
    end
end)

