local function findTarget()
    local foundRemotes = {}
    local priorityTargets = {"WhyAreTheyTargetingMe!!","FisherMan","Chat","AFK","CookiesService"}
    local blacklistedNames = {
        "PlaceCooldownFromChat","AdminPanelService","AdminPanel","IntegrityCheckProcessor",
        "LocalizationTableAnalyticsSender","LocalizationService","Analytics","Telemetry","Logger",
        "Reporter","CanChatWith","SetPlayerBlockList","UpdatePlayerBlockList","NewPlayerGroupDetails",
        "NewPlayerCanManageDetails","SendPlayerBlockList","UpdateLocalPlayerBlockList","SendPlayerProfileSettings",
        "RequestPlayerProfileSettings","UpdatePlayerProfileSettings","ShowFriendJoinedPlayerToast",
        "ShowPlayerJoinedFriendsToast","CreateOrJoinParty","ServerSideBulkPurchaseEvent","SetDialogInUse",
        "ContactListInvokeIrisInviteTeleport","UpdateCurrentCall","RequestDeviceCameraOrientationCapability",
        "ReceiveLikelySpeakingUsers","ReferredPlayerJoin","RE/Tools/Cooldown","RE/FuseMachine/RevealNow",
        "RE/FuseMachine/FuseAnimation","RE/NotificationService/Notify","RE/PlotService/ClaimCoins",
        "RE/PlotService/Sell","RE/PlotService/Open","RE/PlotService/ToggleFriends","RE/PlotService/CashCollected",
        "RE/ChatService/ChatMessage","RE/SoundService/PlayClientSound","RE/Snapshot/RealiableChannel",
        "RE/CommandsService/OpenCommandBar","RE/StealService/Grab","RE/StealService/StealingSuccess",
        "RE/StealService/StealingFailure","RE/CombatService/ApplyImpulse","RE/InventoryService/Sort",
        "RE/StockEventService/SetFocused","RE/StockEventService/Return","RE/StockEventService/Redeem",
        "RE/MerchantService/SetFocused","RE/MerchantService/Animation","RE/ShopService/Purchase",
        "RE/TutorialService/StartTutorial","RE/TutorialService/FinishTutorial","RE/TeleportService/Reconnect"
    }

    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local fullName = v:GetFullName()
            local remoteName = v.Name
            local blocked = false

            for _, b in ipairs(blacklistedNames) do
                if string.find(fullName, b, 1, true) or string.find(remoteName, b, 1, true) then
                    blocked = true
                    break
                end
            end

            if not blocked then
                for _, p in ipairs(priorityTargets) do
                    if string.find(remoteName, p, 1, true) then
                        table.insert(foundRemotes, 1, v)
                        blocked = true
                        break
                    end
                end
                if not blocked then
                    table.insert(foundRemotes, v)
                end
            end
        end
    end

    return foundRemotes[1]
end

